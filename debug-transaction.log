              title: { text: 'School Year Progress', style: { color: '#8B008B', fontSize: '14px' } }
            },
            yaxis: {
              title: { text: 'Algebraic Understanding %', style: { color: '#8B008B', fontSize: '14px' } }
            },
            tooltip: { x: { format: 'Month' } },
            fill: {
              type: 'gradient',
              gradient: { shadeIntensity: 1, opacityFrom: 0.7, opacityTo: 0.3, stops: [0, 90, 100] }
            },
            title: {
              text: 'Pre-Algebra Readiness: Visual Display Impact',
              align: 'center',
              style: { fontSize: '18px', color: '#4B0082' }
            }
          };
        }
        
        function render () {
          const el = document.getElementById(id);
          if (el && window.ApexCharts) new ApexCharts(el, getOptions()).render();
        }
        
        if (window.ApexCharts) {
          render();
        } else {
          if (!window.__apexcharts_callbacks) window.__apexcharts_callbacks = [];
          window.__apexcharts_callbacks.push(render);
          
          if (!window.__apexcharts_loading) {
            window.__apexcharts_loading = true;
            const s = document.createElement('script');
            s.src = CDN;
            s.onload = () => window.__apexcharts_callbacks.forEach(fn => fn());
            document.head.appendChild(s);
          }
        }
      })();
      </script>
      
