      <script>
      (function () {
        const CDN = 'https://cdn.jsdelivr.net/npm/apexcharts@3.49.1/dist/apexcharts.min.js';
        const id = 'apex-area-sprint-timeline';

        const box = document.createElement('div');
        box.id = id;
        box.style.maxWidth = '100%';
        document.currentScript.parentNode.insertBefore(box, document.currentScript);

        function getOptions () {
          return {
            series: [{
              name: 'Funds Raised',
              data: [0, 800, 1500, 2400, 3200, 4100, 5000, 5800, 6500]
            }],
            chart: {
              height: 350,
              type: 'area',
              toolbar: { show: true },
              animations: { enabled: true, easing: 'easeinout', speed: 800 }
            },
            colors: ['#00BCD4'],
            dataLabels: { enabled: false },
            stroke: { curve: 'smooth', width: 3 },
            xaxis: { 
              type: 'category', 
              categories: ['Day 0', 'Day 3', 'Day 7', 'Day 10', 'Day 14', 'Day 18', 'Day 21', 'Day 25', 'Day 30']
            },
            yaxis: {
              title: { text: 'Amount Raised ($)' }
            },
            tooltip: { 
              y: {
                formatter: function(val) {
                  return '$' + val.toLocaleString()
                }
              }
            },
            fill: {
              type: 'gradient',
              gradient: { shadeIntensity: 1, opacityFrom: 0.7, opacityTo: 0.2, stops: [0, 90, 100] }
            }
          };
        }

        function render () {
          const el = document.getElementById(id);
          if (el && window.ApexCharts) new ApexCharts(el, getOptions()).render();
        }

        if (window.ApexCharts) {
          render();
        } else {
          if (!window.__apexcharts_callbacks) window.__apexcharts_callbacks = [];
          window.__apexcharts_callbacks.push(render);

          if (!window.__apexcharts_loading) {
            window.__apexcharts_loading = true;
            const s = document.createElement('script');
            s.src = CDN;
            s.onload = () => window.__apexcharts_callbacks.forEach(fn => fn());
            document.head.appendChild(s);
          }
        }
      })();
      </script>
      
