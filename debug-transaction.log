<script>
(function () {
  const CDN = 'https://cdn.jsdelivr.net/npm/apexcharts@3.49.1/dist/apexcharts.min.js';
  const id = 'poster-machine-cost-comparison';

  const box = document.createElement('div');
  box.id = id;
  box.style.maxWidth = '100%';
  document.currentScript.parentNode.insertBefore(box, document.currentScript);

  function getOptions () {
    return {
      series: [{
        name: 'Initial Purchase',
        data: [8995, 12500, 15800, 7995, 18500]
      }, {
        name: 'Consumables (5yr)',
        data: [4200, 8500, 12000, 3800, 14000]
      }, {
        name: 'Maintenance',
        data: [0, 7500, 8000, 2500, 9500]
      }, {
        name: 'Downtime Costs',
        data: [500, 2500, 3000, 800, 3500]
      }],
      chart: {
