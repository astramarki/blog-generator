<script>
(function () {
  const CDN = 'https://cdn.jsdelivr.net/npm/apexcharts@3.49.1/dist/apexcharts.min.js';
  const id = 'backdrop-cost-comparison';

  const box = document.createElement('div');
  box.id = id;
  box.style.maxWidth = '100%';
  document.currentScript.parentNode.insertBefore(box, document.currentScript);

  function getOptions () {
    return {
      series: [{
        name: 'Traditional Rental',
        data: [1200, 2400, 3600, 4800, 6000]
      }, {
        name: 'In-House Printing',
        data: [120, 240, 360, 480, 600]
      }],
      chart: {
        height: 350,
        type: 'area',
        toolbar: { show: true },
        animations: { enabled: true, easing: 'easeinout', speed: 800 }
      },
      colors: ['#ff6b6b', '#4ecdc4'],
      dataLabels: { enabled: false },
      stroke: { curve: 'smooth', width: 3 },
      xaxis: { 
        categories: ['1 Show', '2 Shows', '3 Shows', '4 Shows', '5 Shows'],
        labels: { style: { fontSize: '14px' } }
      },
      yaxis: {
        title: { text: 'Cost in Dollars' },
        labels: { 
          formatter: function(val) { return '$' + val; }
        }
      },
      tooltip: { 
        y: { formatter: function(val) { return '$' + val; } }
      },
      fill: {
        type: 'gradient',
        gradient: { shadeIntensity: 1, opacityFrom: 0.7, opacityTo: 0.3 }
      },
      title: {
        text: 'Annual Backdrop Costs: Rental vs. In-House Printing',
        align: 'center',
        style: { fontSize: '18px', fontWeight: 600 }
      }
    };
  }

  function render () {
    const el = document.getElementById(id);
    if (el && window.ApexCharts) new ApexCharts(el, getOptions()).render();
  }

  if (window.ApexCharts) {
    render();
  } else {
    if (!window.__apexcharts_callbacks) window.__apexcharts_callbacks = [];
    window.__apexcharts_callbacks.push(render);

    if (!window.__apexcharts_loading) {
      window.__apexcharts_loading = true;
      const s = document.createElement('script');
      s.src = CDN;
      s.onload = () => window.__apexcharts_callbacks.forEach(fn => fn());
      document.head.appendChild(s);
    }
  }
})();
</script>

