(function () {
  const CDN = 'https://cdn.jsdelivr.net/npm/apexcharts@3.49.1/dist/apexcharts.min.js';
  const id = 'apex-area-chart-school-roi';

  const box = document.createElement('div');
  box.id = id;
  box.style.maxWidth = '100%';
  document.currentScript.parentNode.insertBefore(box, document.currentScript);

  function getOptions () {
    return {
      series: [{
        name: 'Small Schools (< 500 students)',
        data: [8.00, 6.50, 5.20, 4.10, 3.50]
      }, {
        name: 'Medium Schools (500-1500 students)',
        data: [6.00, 5.00, 4.20, 3.60, 3.20]
      }, {
        name: 'Large Schools (> 1500 students)',
        data: [4.50, 3.80, 3.30, 3.00, 2.80]
      }],
      chart: {
        height: 350,
        type: 'area',
        toolbar: { show: true },
        animations: { enabled: true, easing: 'easeinout', speed: 800 }
      },
      colors: ['#FF69B4', '#FF1493', '#C71585'],
      dataLabels: { enabled: false },
      stroke: { curve: 'smooth', width: 3 },
      xaxis: { 
        type: 'category', 
        categories: ['Year 1', 'Year 2', 'Year 3', 'Year 4', 'Year 5'],
        title: { text: 'Years of Implementation', style: { color: '#4A4A4A', fontSize: '14px' } }
      },
      yaxis: {
        title: { text: 'Cost Per Student ($)', style: { color: '#4A4A4A', fontSize: '14px' } },
        labels: { formatter: function(val) { return '$' + val.toFixed(2); } }
      },
      tooltip: { 
        x: { format: 'Year' },
        y: { formatter: function(val) { return '$' + val.toFixed(2) + ' per student'; } }
      },
      fill: {
        type: 'gradient',
        gradient: { shadeIntensity: 1, opacityFrom: 0.7, opacityTo: 0.3, stops: [0, 90, 100] }
      },
      legend: { position: 'top', horizontalAlign: 'center' }
    };
  }

  function render () {
    const el = document.getElementById(id);
    if (el && window.ApexCharts) new ApexCharts(el, getOptions()).render();
  }

  if (window.ApexCharts) {
    render();
  } else {
    if (!window.__apexcharts_callbacks) window.__apexcharts_callbacks = [];
    window.__apexcharts_callbacks.push(render);

    if (!window.__apexcharts_loading) {
      window.__apexcharts_loading = true;
      const s = document.createElement('script');
      s.src = CDN;
      s.onload = () => window.__apexcharts_callbacks.forEach(fn => fn());
      document.head.appendChild(s);
    }
  }
})();
</script>

