<script>
(function () {
  const CDN = 'https://cdn.jsdelivr.net/npm/apexcharts@3.49.1/dist/apexcharts.min.js';
  const id = 'apex-area-template-usage';

  const box = document.createElement('div');
  box.id = id;
  box.style.maxWidth = '100%';
  document.currentScript.parentNode.insertBefore(box, document.currentScript);

  function getOptions () {
    return {
      series: [{
        name: 'Templates Created',
        data: [12, 25, 38, 52, 67, 84, 98, 125, 142, 165, 189, 215]
      }, {
        name: 'Templates Reused',
        data: [0, 8, 22, 45, 78, 112, 156, 198, 245, 298, 352, 412]
      }],
      chart: {
        height: 350,
        type: 'area',
        toolbar: { show: true },
        animations: { enabled: true, easing: 'easeinout', speed: 800 }
      },
      colors: ['#FF6B35', '#4ECDC4'],
      dataLabels: { enabled: false },
      stroke: { curve: 'smooth', width: 2 },
      xaxis: { 
        type: 'category', 
        categories: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
      },
      yaxis: {
        title: { text: 'Number of Templates' }
      },
      tooltip: { 
        x: { format: 'MMM' },
        y: { formatter: function(val) { return val + " templates" } }
      },
      fill: {
        type: 'gradient',
        gradient: { shadeIntensity: 1, opacityFrom: 0.7, opacityTo: 0.2, stops: [0, 90, 100] }
      },
      legend: {
        position: 'top',
        horizontalAlign: 'center'
      }
    };
  }

  function render () {
    const el = document.getElementById(id);
    if (el && window.ApexCharts) new ApexCharts(el, getOptions()).render();
  }

  if (window.ApexCharts) {
    render();
  } else {
    if (!window.__apexcharts_callbacks) window.__apexcharts_callbacks = [];
    window.__apexcharts_callbacks.push(render);

    if (!window.__apexcharts_loading) {
      window.__apexcharts_loading = true;
      const s = document.createElement('script');
      s.src = CDN;
      s.onload = () => window.__apexcharts_callbacks.forEach(fn => fn());
      document.head.appendChild(s);
    }
  }
})();
</script>

