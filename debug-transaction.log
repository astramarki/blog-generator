<script>
(function () {
  const CDN = 'https://cdn.jsdelivr.net/npm/apexcharts@3.49.1/dist/apexcharts.min.js';
  const id = 'apex-radial-engagement-metrics';

  const box = document.createElement('div');
  box.id = id;
  box.style.maxWidth = '100%';
  document.currentScript.parentNode.insertBefore(box, document.currentScript);

  function getOptions () {
    return {
      series: [85, 92, 78, 95],
      chart: { height: 390, type: 'radialBar' },
      plotOptions: {
        radialBar: {
          offsetY: 0,
          startAngle: 0,
          endAngle: 270,
          hollow: { margin: 5, size: '30%', background: 'transparent' },
          dataLabels: { name: { show: false }, value: { show: false } },
          barLabels: {
            enabled: true,
            useSeriesColors: true,
            offsetX: -8,
            fontSize: '16px',
            formatter: (seriesName, opts) => seriesName + ': ' + opts.w.globals.series[opts.seriesIndex] + '%'
          }
        }
      },
      colors: ['#FF1493', '#FF69B4', '#FFB6C1', '#FF6347'],
      labels: ['Photo Boards', 'QR Displays', 'Milestone Charts', 'Parent Walls'],
      responsive: [{ breakpoint: 480, options: { legend: { show: false } } }]
    };
  }

  function render () {
    const el = document.getElementById(id);
    if (el && window.ApexCharts) new ApexCharts(el, getOptions()).render();
  }

  if (window.ApexCharts) {
    render();
  } else {
    if (!window.__apexcharts_callbacks) window.__apexcharts_callbacks = [];
    window.__apexcharts_callbacks.push(render);

    if (!window.__apexcharts_loading) {
      window.__apexcharts_loading = true;
      const s = document.createElement('script');
      s.src = CDN;
      s.onload = () => window.__apexcharts_callbacks.forEach(fn => fn());
      document.head.appendChild(s);
    }
  }
})();
</script>

