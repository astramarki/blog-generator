(function () {
  const CDN = 'https://cdn.jsdelivr.net/npm/apexcharts@3.49.1/dist/apexcharts.min.js';
  const id = 'apex-area-chart-savings';

  const box = document.createElement('div');
  box.id = id;
  box.style.maxWidth = '100%';
  document.currentScript.parentNode.insertBefore(box, document.currentScript);

  function getOptions () {
    return {
      series: [{
        name: 'Outsourcing Costs',
        data: [0, 3500, 7000, 10500, 14000, 17500, 21000, 24500, 28000, 31500, 35000, 38500]
      }, {
        name: 'In-House Production',
        data: [8995, 9745, 10495, 11245, 11995, 12745, 13495, 14245, 14995, 15745, 16495, 17245]
      }],
      chart: {
        height: 350,
        type: 'area',
        toolbar: { show: true },
        animations: { enabled: true, easing: 'easeinout', speed: 800 }
      },
      colors: ['#FF6B6B', '#4ECDC4'],
      dataLabels: { enabled: false },
      stroke: { curve: 'smooth', width: 3 },
      xaxis: { 
        type: 'category', 
        categories: ['Month 0', 'Month 3', 'Month 6', 'Month 9', 'Month 12', 'Month 15', 'Month 18', 'Month 21', 'Month 24', 'Month 27', 'Month 30', 'Month 36'],
        title: { text: 'Time Period', style: { fontSize: '14px' } }
      },
      yaxis: {
        title: { text: 'Cumulative Cost ($)', style: { fontSize: '14px' } },
        labels: { formatter: (value) => '$' + value.toLocaleString() }
      },
      tooltip: { 
        x: { format: 'Month' },
        y: { formatter: (value) => '$' + value.toLocaleString() }
      },
      fill: {
        type: 'gradient',
        gradient: { shadeIntensity: 1, opacityFrom: 0.7, opacityTo: 0.2, stops: [0, 90, 100] }
      },
      annotations: {
        points: [{
          x: 'Month 9',
          seriesIndex: 0,
          label: {
            borderColor: '#775DD0',
            offsetY: 0,
            style: { color: '#fff', background: '#775DD0' },
            text: 'Break-Even Point'
          }
        }]
      }
    };
  }

  function render () {
    const el = document.getElementById(id);
    if (el && window.ApexCharts) new ApexCharts(el, getOptions()).render();
  }

  if (window.ApexCharts) {
    render();
  } else {
    if (!window.__apexcharts_callbacks) window.__apexcharts_callbacks = [];
    window.__apexcharts_callbacks.push(render);

    if (!window.__apexcharts_loading) {
      window.__apexcharts_loading = true;
      const s = document.createElement('script');
      s.src = CDN;
      s.onload = () => window.__apexcharts_callbacks.forEach(fn => fn());
      document.head.appendChild(s);
    }
  }
})();
</script>

